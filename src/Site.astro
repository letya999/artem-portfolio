---
import '@fontsource-variable/manrope';
import '@fontsource-variable/oswald';
import './style.css';
import messages from './messages.json';
import {jobs,businesses,achievements,biography} from './portfolio-data.js';
import {profileMeta} from './seo.js';
import {resumeMarkdown} from './resume.js';
import oswaldLatin from '@fontsource-variable/oswald/files/oswald-latin-wght-normal.woff2?url';
import oswaldCyrillic from '@fontsource-variable/oswald/files/oswald-cyrillic-wght-normal.woff2?url';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import manropeCyrillic from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import Arrow from './Arrow.astro';
import Analytics from './Analytics.astro';
import PortraitIsland from './islands/PortraitIsland.jsx';
import PracticeIsland from './islands/PracticeIsland.jsx';
import ConveyorIsland from './islands/ConveyorIsland.jsx';
const {locale,root=false}=Astro.props;
const t=text=>messages[text]?.[locale]??text;
const origin=import.meta.env.SITE_URL||'';
const path=root?'/':`/${locale}`;
const {title,description,url,image,schema}=profileMeta(locale,t,origin,path);
const schemaJson=JSON.stringify(schema).replaceAll('<','\\u003c');
const markdown=resumeMarkdown(t);
---
<!doctype html>
<html lang={locale}>
<head>
 <Analytics />
 <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 <link rel="preload" href={locale==='en'?oswaldLatin:oswaldCyrillic} as="font" type="font/woff2" crossorigin />
 <link rel="preload" href={locale==='en'?manropeLatin:manropeCyrillic} as="font" type="font/woff2" crossorigin />
 <meta name="description" content={description} />
 <meta name="theme-color" content="#efefeb" />
 <meta name="site-origin" content={origin} />
 <meta name="robots" content="index,follow,max-image-preview:large" />
 {origin&&<link rel="canonical" href={url} />}
 {origin&&['ru','en','kk'].map(lang=><link rel="alternate" hreflang={lang} href={`${origin}/${lang}`} />)}
 {origin&&<link rel="alternate" hreflang="x-default" href={`${origin}/`} />}
 <meta property="og:type" content="website" />
 <meta property="og:site_name" content="Artem Letyushev" />
 <meta property="og:title" content={title} />
 <meta property="og:description" content={description} />
 <meta property="og:url" content={url} />
 <meta property="og:image" content={image} />
 <meta property="og:image:type" content="image/png" />
 <meta property="og:image:width" content="1200" />
 <meta property="og:image:height" content="630" />
 <meta property="og:image:alt" content={`${t('Артем Летюшев')} — ${t('Tech Project Manager')}`} />
 <meta property="og:locale" content={{ru:'ru_RU',en:'en_US',kk:'kk_KZ'}[locale]} />
 <meta name="twitter:card" content="summary_large_image" />
 <meta name="twitter:title" content={title} />
 <meta name="twitter:description" content={description} />
 <meta name="twitter:image" content={image} />
 <meta name="twitter:image:alt" content={`${t('Артем Летюшев')} — ${t('Tech Project Manager')}`} />
 <meta name="author" content={t('Артем Летюшев')} />
 <link rel="alternate" type="text/markdown" title="Agent guide" href="/agents.md" />
 <link rel="alternate" type="text/markdown" title="Portfolio skill" href="/skill.md" />
 <script id="profile-schema" type="application/ld+json" set:html={schemaJson} />
 <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
 <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
 <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
 <link rel="shortcut icon" href="/favicon.ico" />
 <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
 <link rel="mask-icon" href="/mask-icon.svg" color="#20211f" />
 <link rel="manifest" href="/site.webmanifest" />
 {['ru','en','kk'].map(lang=><link rel="alternate" type="text/markdown" lang={lang} href={`/resume.${lang}.md`} />)}
 <title>{title}</title>
 <noscript><style is:inline>.portrait-fallback{visibility:visible!important}</style></noscript>
 <script is:inline>
  if(location.pathname==='/'){
   let saved;try{saved=localStorage.getItem('portfolio-language')}catch{}
   const chosen=['ru','en','kk'].includes(saved)?saved:(navigator.languages||[navigator.language]).map(value=>value.toLowerCase().split('-')[0]).find(value=>['ru','en','kk'].includes(value))||'en';
   location.replace(`/${chosen}${location.search}${location.hash}`);
  }
  if(new URLSearchParams(location.search).get('view')==='agent')document.documentElement.dataset.view='agent';
 </script>
 <style is:global>html:not([data-view="agent"]) .agent-shell{display:none}html[data-view="agent"] .human-shell{display:none}</style>
</head>
<body>
 <div class="human-shell">
  <a class="skip" href="#main">{t('К содержанию')}</a>
  <header>
   <a id="home-link" class="mark" href="#top" aria-label={t('Artem Letyushev — в начало')}><span class="logo-images" aria-hidden="true"><img class="logo-mono" src="/brand/logo-mono.png" alt="" width="48" height="48" /><img class="logo-color" src="/brand/logo-color.png" alt="" width="48" height="48" /></span><span class="logo-name">Artem Letyushev</span></a>
   <nav aria-label={t('Основная навигация')}><a href="#results">{t('Результаты')}</a><a href="#experience">{t('Опыт')}</a><a href="#about">{t('Обо мне')}</a><a href="#conveyor">{t('Мои ресурсы').replace(/\.$/,'')}</a><a href="#contact">{t('Контакт')}</a></nav>
   <details class="resume-menu">
    <summary>{t('Резюме')}<svg class="resume-chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
    <div class="resume-options"><a id="resume-pdf" href="/Artem-Letyushev-CV.pdf" hreflang="ru" download><span>.PDF · RU</span><Arrow /></a><a id="resume-markdown" href={`/resume.${locale}.md`} download={`Artem-Letyushev-${locale}.md`}><span>.MD</span><Arrow /></a></div>
   </details>
   <select id="language-select" class="language-select" aria-label={t('Язык')} data-language>
    <option value="ru" selected={locale==='ru'}>RU</option><option value="en" selected={locale==='en'}>EN</option><option value="kk" selected={locale==='kk'}>ҚАЗ</option>
   </select>
  </header>
  <main id="main">
   <section class="hero" id="top">
    <div class="hero-copy">
     <h1 aria-label={t('Артем Летюшев')}><span>{t('АРТЕМ')}</span><span>{t('ЛЕТЮШЕВ')}<span class="name-dot">.</span></span></h1>
     <p class="role">{t('Tech Project Manager')}</p>
     <p class="intro">{t('Соединяю инженерию,')}<br />{t('команды и бизнес.')}</p>
     <a id="contact-cta" class="primary" href="#contact">{t('Обсудить работу')}<Arrow /></a>
     <p class="hero-note">{t('7+ лет. Финтех, телеком, дейтинг.')}<br />{t('От требований до запуска.')}</p>
    </div>
    <PortraitIsland locale={locale} client:idle />
    <div class="hero-bottom"><a href="#results">{t('Дальше — результаты')}<span aria-hidden="true">↓</span></a></div>
   </section>
   <section class="results" id="results">
    <h2 class="achievements-heading"><a href="#results">{t('Результаты.')}</a></h2>
    <div class="achievements-body">
     <div class="achievement-list">
      {achievements.map(([heading,highlight,body])=><article><h3>{t(heading)}</h3><strong>{t(highlight)}</strong><p>{t(body)}</p></article>)}
     </div>
     <div class="little-law" role="img" aria-label={t('Закон Литтла: Lead time равно WIP, делённому на Throughput')}><div class="equation-slot"><div class="equation-typeset" aria-hidden="true"><span>Lead time</span><span>=</span><span class="equation-fraction"><span>WIP</span><span>Throughput</span></span></div></div></div>
    </div>
   </section>
   <section class="experience" id="experience">
    <div class="section-top"><h2><a href="#experience">{t('Опыт работы')}</a></h2><p>{t('2026 → 2019. Сначала последнее место работы. Раскройте компанию, чтобы увидеть задачи и результаты.')}</p></div>
    <div class="experience-body"><div class="history">
     {jobs.map(([company,role,date,scope,points,responsibilities,projects],i)=><div class="career-entry"><details open={i===0} data-company={company}><summary><span class="company-line"><span class="company">{t(company)}</span><span class="business">{t(businesses[company])}</span></span><span class="job">{t(role)}</span><span class="date">{t(date)}</span><span class="disclosure"><span class="when-closed">{t('Подробнее')}</span><span class="when-open">{t('Свернуть')}</span><span class="plus" aria-hidden="true">+</span></span></summary><div class="job-content"><p>{t(scope)}</p><h3>{t('Проекты')}</h3><p>{t(projects)}</p><h3>{t('Результаты')}</h3><ul class="job-results">{points.map(point=><li>{t(point)}</li>)}</ul><h3>{t('Обязанности')}</h3><ul class="job-responsibilities">{responsibilities.map(point=><li>{t(point)}</li>)}</ul></div></details><div class="matryoshka-slot" role="img" aria-label={`${t('Матрёшка')}: ${t(company)}`}><p class="matryoshka-fallback">{t(company)}</p></div></div>)}
    </div></div>
   </section>
   <section class="about" id="about"><div class="about-photo"><picture><source srcset="/artem-books.webp" type="image/webp" /><img src="/artem-books.jpg" alt={t('Артем в книжном магазине у полки об искусственном интеллекте')} width="640" height="640" loading="lazy" /></picture></div><div class="about-copy"><h2 class="about-sticker"><a href="#about">{t('Менеджер с инженерным взглядом.')}</a></h2>{biography.map(paragraph=><p>{t(paragraph)}</p>)}<a class="text-link" href="https://github.com/letya999" target="_blank" rel="noreferrer">{t('Мои проекты на GitHub')}<Arrow /></a></div></section>
   <PracticeIsland locale={locale} client:visible />
   <ConveyorIsland locale={locale} client:visible />
   <footer id="contact"><div class="contact-top"><h2><a href="#contact">{t('Давайте')}<br />{' '}{t('соберёмся.')}</a></h2><div><p>{t('Ищете Tech / Delivery PM,')}<br />{t('который понимает и код, и людей?')}</p><a class="primary" href="https://t.me/artemletya" target="_blank" rel="noreferrer">{t('Написать в Telegram')}<Arrow /></a><a class="email" href="mailto:artemletyushev@gmail.com">artemletyushev@gmail.com</a></div></div><div class="footer-bottom"><span>{t('Артем Летюшев · 2026')}</span><a href="https://www.linkedin.com/in/artemletya" target="_blank" rel="noreferrer">LinkedIn <Arrow /></a><a href={locale==='ru'?'/Artem-Letyushev-CV.pdf':`/resume.${locale}.md`} download>{t('Скачать резюме')}<Arrow /></a><a href="#top">{t('Наверх ↑')}</a></div></footer>
  </main>
 </div>
 <template id="agent-template"><div class="agent-shell"><header><a href="?view=human">← {t('Сайт')}</a><a href={`/resume.${locale}.md`} download={`Artem-Letyushev-${locale}.md`}>{t('Резюме MD')} ↓</a></header><main><nav><a href="/skill.md">SKILL.md</a> · <a href="/agents.md">agents.md</a> · <a href="/mcp.json">MCP</a> · <a href="/llms.txt">llms.txt</a></nav><pre>{markdown}</pre></main></div></template>
 <aside class="view-dock" aria-label={t('Формат сайта')}><a href="?view=human" aria-current="page"><span class="switch-state" aria-hidden="true">I</span><span>{t('Human')}</span><span class="switch-off" aria-hidden="true">O</span></a><a href="?view=agent"><span class="switch-state" aria-hidden="true">I</span><span>{t('Agent')}</span><span class="switch-off" aria-hidden="true">O</span></a></aside>
 <script is:inline>
  const resumeMenu=document.querySelector('.resume-menu');
  if(resumeMenu){
   addEventListener('click',event=>{if(!resumeMenu.contains(event.target)||event.target.closest('a'))resumeMenu.open=false;});
   addEventListener('keydown',event=>{if(event.key==='Escape'&&resumeMenu.open){resumeMenu.open=false;resumeMenu.querySelector('summary').focus();}});
  }
  const sectionNav=document.documentElement.dataset.view==='agent'?null:document.querySelector('.human-shell > header nav');
  if(sectionNav){
   const links=[...sectionNav.querySelectorAll('a')];
   const sections=[...document.querySelectorAll('.human-shell main section[id], .human-shell main footer[id]')];
   const updateSection=()=>{
    let current;
    for(const section of sections)if(section.offsetTop<=scrollY+sectionNav.parentElement.offsetHeight+64)current=section.id;
    for(const link of links){
     if(link.hash.slice(1)===current)link.setAttribute('aria-current','location');
     else link.removeAttribute('aria-current');
    }
   };
   updateSection();
   addEventListener('scroll',updateSection,{passive:true});
   addEventListener('resize',updateSection);
  }
  if(document.documentElement.dataset.view==='agent'){
   const fragment=document.querySelector('#agent-template').content.cloneNode(true);
   fragment.querySelector('.agent-shell header').append(document.querySelector('select[data-language]'));
   document.querySelector('.human-shell').replaceWith(fragment);
   const [human,agent]=document.querySelectorAll('.view-dock a');
   human.removeAttribute('aria-current');agent.setAttribute('aria-current','page');
  }
  const dock=document.querySelector('.view-dock');
  dock.addEventListener('click',async event=>{
   const target=event.target.closest('a');
   if(!target||event.button!==0||event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;
   if(dock.dataset.switching||target.hasAttribute('aria-current')){event.preventDefault();return;}
   event.preventDefault();
   if(matchMedia('(prefers-reduced-motion: reduce)').matches){location.assign(target.href);return;}
   const current=dock.querySelector('a[aria-current]');
   dock.dataset.switching='releasing';
   const release=current.animate([
    {transform:'rotateX(-12deg) translateY(4px)'},
    {transform:'rotateX(15deg) translateY(-4px)',offset:.78},
    {transform:'rotateX(12deg) translateY(-3px)'}
   ],{duration:360,easing:'cubic-bezier(.72,0,.26,1)',fill:'forwards'});
   await release.finished;current.removeAttribute('aria-current');release.cancel();
   await new Promise(resolve=>setTimeout(resolve,120));
   dock.dataset.switching='engaging';
   const engage=target.animate([
    {transform:'rotateX(12deg) translateY(-3px)'},
    {transform:'rotateX(-16deg) translateY(5px)',offset:.76},
    {transform:'rotateX(-12deg) translateY(4px)'}
   ],{duration:390,easing:'cubic-bezier(.72,0,.24,1)',fill:'forwards'});
   target.setAttribute('aria-current','page');
   await engage.finished;engage.cancel();
   await new Promise(resolve=>setTimeout(resolve,140));
   location.assign(target.href);
  });
  document.querySelectorAll('select[data-language]').forEach(select=>select.addEventListener('change',()=>{
   const locale=select.value;if(!['ru','en','kk'].includes(locale))return;
   try{localStorage.setItem('portfolio-language',locale)}catch{}
   location.assign(`/${locale}${location.search}${location.hash}`);
  }));
 </script>
</body>
</html>
